    "$comment": "Native apps use springs (response in seconds, bounce). The CSS easings are close approximations.",
    "quick": { "response": 0.22, "bounce": 0, "css": "220ms cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "settle": { "response": 0.38, "bounce": 0.08, "css": "380ms cubic-bezier(0.34, 1.2, 0.64, 1)" },
